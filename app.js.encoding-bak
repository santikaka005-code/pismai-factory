        <div>
          <span>เธเธเธฑเธเธเธฒเธเนเธเนเธเธฒเธ</span>
          <strong>${activeEmployees} เธเธ</strong>
        </div>
        <div>
          <span>เธฃเธฒเธขเธเธฒเธฃเธงเธฑเธเธเธตเน</span>
          <strong>${todayRecords.length} เธฃเธฒเธขเธเธฒเธฃ</strong>
        </div>
        <div>
          <span>เธขเธญเธ”เน€เธเธดเธเธงเธฑเธเธเธตเน</span>
          <strong>${money(todayTotals.amount)}</strong>
        </div>
      </div>

      <section class="factory-section">
