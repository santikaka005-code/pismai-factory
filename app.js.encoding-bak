          <div class="metric-card"><span>เธเนเธณเธซเธเธฑเธเธฃเธงเธกเธ—เธฑเนเธเธซเธกเธ”</span><strong>${numberText(totals.water + totals.flower)} เธเธ.</strong><small>เธเนเธณ ${numberText(totals.water)} เธเธ. | เธ”เธญเธ ${numberText(totals.flower)} เธเธ.</small></div>
          <div class="metric-card"><span>เธเธเธฑเธเธเธฒเธเธ—เธตเนเธกเธตเธฃเธฒเธขเธเธฒเธฃ</span><strong>${totals.people.size} เธเธ</strong><small>เธฃเธงเธกเธ—เธฑเนเธเธซเธกเธ”</small></div>
          <div class="metric-card"><span>เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ</span><strong>${records.length}</strong><small>เธฃเธฒเธขเธเธฒเธฃเธ—เธฑเนเธเธซเธกเธ”</small></div>
          <div class="metric-card"><span>เธเนเธญเธกเธนเธฅเธฅเนเธฒเธชเธธเธ”</span><strong>${latestRecords[0]?.record_date || "-"}</strong><small>${latestRecords[0]?.record_time || "เธขเธฑเธเนเธกเนเธกเธตเธฃเธฒเธขเธเธฒเธฃ"}</small></div>
        </div>
      </section>

      ${renderProductionRecordsTable(latestRecords, false)}
    </section>
  `;
}
function renderDashboard(user, moduleItem) {
  const dateLabel = new Intl.DateTimeFormat("th-TH", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric"
  }).format(new Date());
  const canManageReports = ["admin", "hr"].includes(user.role);
  const canManageSettings = user.role === "admin";

  return `
    <section class="factory-dashboard">
      <div class="factory-hero">
        <div class="factory-hero-copy">
          <p class="eyebrow">Pitsamai Frozen Fruits Co., Ltd.</p>
          <h2>เธขเธดเธเธ”เธตเธ•เนเธญเธเธฃเธฑเธเธชเธนเนเธฃเธฐเธเธเนเธฃเธเธเธฒเธ</h2>
          <p>
            เธจเธนเธเธขเนเธเธงเธเธเธธเธกเธเธฒเธเธเธฑเธเธ—เธถเธเธเธฅเธเธฅเธดเธ•เนเธฅเธฐเธเนเธฒเนเธฃเธเธเธฃเธฐเธเธณเธงเธฑเธ
            เธชเธณเธซเธฃเธฑเธเธเนเธฒเธขเธเธฅเธดเธ• เธเนเธฒเธขเธเธธเธเธเธฅ เนเธฅเธฐเธเธนเนเธ”เธนเนเธฅเธฃเธฐเธเธ
          </p>
          <div class="factory-hero-actions">
            <button class="btn btn-primary" type="button" data-route="production">เธเธฑเธเธ—เธถเธเธเธฅเธเธฅเธดเธ•</button>
            <button class="btn btn-outline" type="button" data-route="summary-all">เธ”เธนเธชเธฃเธธเธเธเนเธญเธกเธนเธฅเธ—เธฑเนเธเธซเธกเธ”</button>
          </div>
        </div>
        <div class="factory-hero-brand">
          <img src="assets/pitsamai-logo.png" alt="Pitsamai" />
          <span>Factory Wage System</span>
        </div>
      </div>

      <div class="factory-status-strip">
        <div>
          <span>เธงเธฑเธเธ—เธตเนเนเธเนเธเธฒเธ</span>
          <strong>${escapeHtml(dateLabel)}</strong>
        </div>
        <div>
          <span>เธเธนเนเนเธเนเธเธฒเธ</span>
          <strong>${escapeHtml(user.fullname)}</strong>
        </div>
        <div>
          <span>เธชเธดเธ—เธเธดเนเธฃเธฐเธเธ</span>
          <strong>${escapeHtml(user.role_label || user.role)}</strong>
        </div>
      </div>

      <section class="factory-section">
        <div class="section-title-row">
          <div>
            <h3>เน€เธกเธเธนเธเธฒเธเธซเธฅเธฑเธ</h3>
            <p>เน€เธฅเธทเธญเธเธเธฒเธเธ—เธตเนเธ•เนเธญเธเธเธฒเธฃเธ”เธณเน€เธเธดเธเธเธฒเธฃเนเธเธฃเธฐเธเธเนเธฃเธเธเธฒเธ</p>
          </div>
        </div>
        <div class="factory-action-grid">
          <button class="factory-action-card" type="button" data-route="production">
            <span class="factory-action-icon">โ–ฃ</span>
            <strong>เธเธฑเธเธ—เธถเธเธเธฅเธเธฅเธดเธ•</strong>
            <small>เธเธฃเธญเธเธเนเธณเธซเธเธฑเธเธเนเธณ เธ”เธญเธ เนเธฅเธฐเธเนเธฒเนเธฃเธเธเธญเธเธเธเธฑเธเธเธฒเธ</small>
          </button>
          <button class="factory-action-card" type="button" data-route="summary-all">
            <span class="factory-action-icon">โ–ค</span>
            <strong>เธชเธฃเธธเธเธเนเธญเธกเธนเธฅเธ—เธฑเนเธเธซเธกเธ”</strong>
            <small>เน€เธเธดเธ”เธซเธเนเธฒเธฃเธฒเธขเธเธฒเธเธ•เธฑเธงเน€เธฅเธ เธเธฃเธฒเธ เนเธฅเธฐเธ•เธฒเธฃเธฒเธเธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”</small>
          </button>
          ${
            canManageReports
              ? `<button class="factory-action-card" type="button" data-route="summary-person">
                  <span class="factory-action-icon">โ—</span>
                  <strong>เธชเธฃเธธเธเธฃเธฒเธขเธเธธเธเธเธฅ</strong>
                  <small>เธ•เธฃเธงเธเธชเธญเธเธเธฅเธเธฒเธเนเธขเธเธ•เธฒเธกเธเธเธฑเธเธเธฒเธ</small>
                </button>`
              : ""
          }
          ${
            canManageSettings
              ? `<button class="factory-action-card" type="button" data-route="settings">
                  <span class="factory-action-icon">โ</span>
                  <strong>เธ•เธฑเนเธเธเนเธฒเธฃเธฐเธเธ</strong>
                  <small>เธเธฑเธ”เธเธฒเธฃเธเนเธญเธกเธนเธฅเธซเธฅเธฑเธเนเธฅเธฐเธชเธดเธ—เธเธดเนเธเธนเนเนเธเนเธเธฒเธ</small>
                </button>`
              : ""
          }
        </div>
      </section>

      <section class="factory-section">
        <div class="factory-notice">
          <div>
            <h3>เนเธเธงเธ—เธฒเธเธเธฒเธฃเนเธเนเธเธฒเธเธเธฃเธฐเธเธณเธงเธฑเธ</h3>
            <p>เน€เธฃเธดเนเธกเธเธฒเธเธเธฑเธเธ—เธถเธเธเธฅเธเธฅเธดเธ• เธ•เธฃเธงเธเธชเธญเธเธเธงเธฒเธกเธ–เธนเธเธ•เนเธญเธ เนเธฅเนเธงเธเธถเธเน€เธเธดเธ”เธซเธเนเธฒเธชเธฃเธธเธเน€เธเธทเนเธญเธเธดเธกเธเนเธซเธฃเธทเธญเธชเนเธเธ•เนเธญเธฃเธฒเธขเธเธฒเธ</p>
          </div>
          <button class="btn btn-outline" type="button" data-route="summary-all">เนเธเธซเธเนเธฒเธชเธฃเธธเธ</button>
