}

function renderSummaryTimeOverview(moduleItem) {
  const range = getTimeSummaryRange();
  const records = getTimeSummaryRecords();
  const summary = summarizeTimeRecords(records);
  const byDate = getTimeSummaryByDate(records);
  const byEmployee = getTimeSummaryByEmployee(records);
  const departments = getTimeSummaryDepartments();
  const departmentOptions = departments
    .map((department) => {
      const label = department === "all" ? "เธ—เธธเธเนเธเธเธ" : department;
      return `<option value="${escapeHtml(department)}" ${department === timeSummaryDepartment ? "selected" : ""}>${escapeHtml(label)}</option>`;
    })
    .join("");

  return `
    <section class="time-summary-page">
      <div class="summary-header time-summary-header">
        <div>
          <h2>${escapeHtml(moduleItem.label || "เธชเธฃเธธเธเธเนเธญเธกเธนเธฅเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธ")}</h2>
          <p>เธชเธฃเธธเธเน€เธงเธฅเธฒเน€เธเนเธฒเธญเธญเธเธเธฒเธเธเธฒเธเธเธฒเธเธเนเธญเธกเธนเธฅเน€เธงเธฅเธฒเธ—เธณเธเธฒเธ เน€เธฅเธทเธญเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธซเธฃเธทเธญเนเธเธเธเนเธฅเนเธงเธเนเธญเธกเธนเธฅเธ—เธธเธเธ•เธฒเธฃเธฒเธเธเธฐเน€เธเธฅเธตเนเธขเธเธ•เธฒเธกเธ—เธฑเธเธ—เธต</p>
        </div>
        <button class="btn btn-outline" type="button" data-route="summary-all">เธเธฅเธฑเธเนเธเธซเธเนเธฒเธชเธฃเธธเธ</button>
      </div>

      ${
        timeSummaryMessage
          ? `<div class="alert ${timeSummaryMessageType === "error" ? "alert-error" : "alert-success"}">${escapeHtml(timeSummaryMessage)}</div>`
          : ""
      }

      <section class="panel time-summary-control-panel">
        <form class="time-summary-form" id="timeSummaryForm">
          <label class="field">
            <span>เธเธฒเธเธงเธฑเธเธ—เธตเน</span>
            <input id="timeSummaryStartDate" name="start_date" type="date" value="${escapeHtml(range.startDate)}" required />
          </label>
          <label class="field">
            <span>เธ–เธถเธเธงเธฑเธเธ—เธตเน</span>
            <input id="timeSummaryEndDate" name="end_date" type="date" value="${escapeHtml(range.endDate)}" required />
          </label>
          <label class="field">
            <span>เนเธเธเธ</span>
            <select id="timeSummaryDepartment" name="department">${departmentOptions}</select>
          </label>
          <button class="btn btn-outline" type="submit">เนเธชเธ”เธเธเนเธญเธกเธนเธฅ</button>
          <button class="btn btn-primary time-summary-export-button" id="exportTimeSummary" type="button">Export</button>
        </form>
        <div class="time-summary-export-options">
          <label><input type="checkbox" data-time-export-option="overview" checked /> เธ เธฒเธเธฃเธงเธก</label>
          <label><input type="checkbox" data-time-export-option="daily" checked /> เธชเธฃเธธเธเธฃเธฒเธขเธงเธฑเธ</label>
          <label><input type="checkbox" data-time-export-option="employees" checked /> เธฃเธฒเธขเธเธเธฑเธเธเธฒเธ</label>
          <label><input type="checkbox" data-time-export-option="details" checked /> เธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”</label>
        </div>
      </section>

      ${
        records.length
          ? `
            <div class="summary-metrics time-summary-metrics">
              ${renderTimeSummaryMetricCard("เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ", `${summary.totalRecords.toLocaleString("th-TH")} เธฃเธฒเธขเธเธฒเธฃ`, `${summary.workDays.size.toLocaleString("th-TH")} เธงเธฑเธเธ—เธณเธเธฒเธ`, "metric-green")}
              ${renderTimeSummaryMetricCard("เธเธเธฑเธเธเธฒเธ", `${summary.employeeKeys.size.toLocaleString("th-TH")} เธเธ`, timeSummaryDepartment === "all" ? "เธฃเธงเธกเธ—เธธเธเนเธเธเธ" : timeSummaryDepartment, "metric-blue")}
              ${renderTimeSummaryMetricCard("เน€เธงเธฅเธฒเธชเธธเธ—เธเธดเธฃเธงเธก", `${formatMinutesToHourText(summary.totalNetMinutes)} เธเธก.`, `${formatDecimalHours(summary.totalNetMinutes)} เธเธฑเนเธงเนเธกเธ`, "metric-purple")}
              ${renderTimeSummaryMetricCard("เธชเธ–เธฒเธเธฐเน€เธงเธฅเธฒ", `เธชเธฒเธข ${summary.lateCount.toLocaleString("th-TH")} / เธญเธญเธเธเนเธญเธ ${summary.earlyOutCount.toLocaleString("th-TH")}`, "เน€เธ—เธตเธขเธเน€เธงเธฅเธฒเน€เธเนเธฒ 08:00 เนเธฅเธฐเน€เธงเธฅเธฒเธญเธญเธ 17:00", "metric-orange")}
            </div>

            <section class="time-summary-grid">
              <section class="table-card">
                <div class="table-heading">เธชเธฃเธธเธเธฃเธฒเธขเธงเธฑเธ</div>
                <div class="table-scroll">
                  <table>
                    <thead>
                      <tr>
                        <th>เธงเธฑเธเธ—เธตเน</th>
                        <th>เธฃเธฒเธขเธเธฒเธฃ</th>
                        <th>เธเธเธฑเธเธเธฒเธ</th>
                        <th>เน€เธงเธฅเธฒเธชเธธเธ—เธเธด</th>
                        <th>เธเธฑเนเธงเนเธกเธ</th>
                        <th>เธกเธฒเธชเธฒเธข</th>
                        <th>เธญเธญเธเธเนเธญเธ</th>
                      </tr>
                    </thead>
                    <tbody>${byDate.map(renderTimeSummaryDailyRow).join("")}</tbody>
                  </table>
                </div>
              </section>

              <section class="table-card">
                <div class="table-heading">เธชเธฃเธธเธเธฃเธฒเธขเธเธเธฑเธเธเธฒเธ</div>
                <div class="table-scroll">
                  <table>
                    <thead>
                      <tr>
                        <th>เธฃเธซเธฑเธช</th>
                        <th>เธเธทเนเธญเธเธเธฑเธเธเธฒเธ</th>
                        <th>เนเธเธเธ</th>
                        <th>เธงเธฑเธ</th>
                        <th>เธฃเธฒเธขเธเธฒเธฃ</th>
                        <th>เน€เธงเธฅเธฒเธชเธธเธ—เธเธด</th>
                        <th>เธเธฑเนเธงเนเธกเธ</th>
                        <th>เธชเธฒเธข</th>
                        <th>เธญเธญเธเธเนเธญเธ</th>
                      </tr>
                    </thead>
                    <tbody>${byEmployee.map(renderTimeSummaryEmployeeRow).join("")}</tbody>
                  </table>
                </div>
              </section>
            </section>

            <section class="table-card">
              <div class="table-heading">เธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”เน€เธงเธฅเธฒเน€เธเนเธฒเธญเธญเธเธเธฒเธ</div>
              <div class="table-scroll">
                <table>
                  <thead>
                    <tr>
                      <th>เธงเธฑเธเธ—เธตเน</th>
                      <th>เธฃเธซเธฑเธช</th>
                      <th>เธเธทเนเธญเธเธเธฑเธเธเธฒเธ</th>
                      <th>เนเธเธเธ</th>
                      <th>เน€เธเนเธฒ</th>
                      <th>เธญเธญเธ</th>
                      <th>เธเธฑเธ</th>
                      <th>เธชเธธเธ—เธเธด</th>
                      <th>เธเธฑเนเธงเนเธกเธ</th>
                      <th>เธเธนเนเธเธฑเธเธ—เธถเธ</th>
                    </tr>
                  </thead>
                  <tbody>${records.map(renderTimeSummaryDetailRow).join("")}</tbody>
                </table>
              </div>
            </section>
          `
          : `
            <section class="panel">
              <div class="empty-state">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธ—เธตเนเน€เธฅเธทเธญเธ</div>
            </section>
          `
      }
    </section>
  `;
}

function bindTimeSummaryEvents() {
  const form = document.querySelector("#timeSummaryForm");
  const applyFilter = () => {
    const formData = new FormData(form);
    timeSummaryStartDate = formData.get("start_date") || new Date().toISOString().slice(0, 10);
    timeSummaryEndDate = formData.get("end_date") || timeSummaryStartDate;
    timeSummaryDepartment = formData.get("department") || "all";
    timeSummaryMessage = "";
    render();
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    applyFilter();
  });

  form?.querySelectorAll("input, select").forEach((input) => {
    input.addEventListener("change", applyFilter);
  });

  document.querySelector("#exportTimeSummary")?.addEventListener("click", exportTimeSummaryData);
}

function getPersonalReportContext() {
  const employees = getEmployees().filter((employee) => employee.status === "Active");
  const preferredEmployeeId = Number(personalReportEmployeeId);
  const selectedEmployeeId = employees.some((employee) => employee.id === preferredEmployeeId)
    ? preferredEmployeeId
    : employees[0]?.id || "";
  personalReportEmployeeId = selectedEmployeeId ? String(selectedEmployeeId) : "";

  return {
    employees,
    selectedEmployeeId,
    selectedEmployee: employees.find((employee) => employee.id === Number(selectedEmployeeId)),
    range: normalizeDateRange(personalReportStartDate, personalReportEndDate)
  };
}

function recordsForPersonalTimeReport(employeeId, startDate, endDate) {
  const range = normalizeDateRange(startDate, endDate);
  return getTimeRecords()
    .filter((record) => {
      const recordDate = record.record_date || "";
      return (
        Number(record.employee_id) === Number(employeeId) &&
        recordDate >= range.startDate &&
        recordDate <= range.endDate
      );
    })
    .sort((a, b) =>
      `${a.record_date || ""} ${a.clock_in || ""}`.localeCompare(
        `${b.record_date || ""} ${b.clock_in || ""}`
      )
    );
}

function getPersonalTimeDailySummaries(records) {
  return getTimeSummaryByDate(records);
}

function exportPersonalTimeSummary() {
  const context = getPersonalReportContext();
  if (!context.selectedEmployee) {
    setPersonalReportMessage("เธเธฃเธธเธ“เธฒเน€เธฅเธทเธญเธเธเธเธฑเธเธเธฒเธเธเนเธญเธ Export", "error");
    render();
    return;
  }

  const records = recordsForPersonalTimeReport(
    context.selectedEmployee.id,
    context.range.startDate,
    context.range.endDate
  );
  if (!records.length) {
    setPersonalReportMessage("เนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเธเธญเธเธเธเธฑเธเธเธฒเธเธเธเธเธตเนเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธ—เธตเนเน€เธฅเธทเธญเธ", "error");
    render();
    return;
  }

  const summary = summarizeTimeRecords(records);
  const dailySummaries = getPersonalTimeDailySummaries(records);
  const lines = [
    csvRow(["เธฃเธฒเธขเธเธฒเธเธชเธฃเธธเธเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเธฃเธฒเธขเธเธธเธเธเธฅ"]),
    csvRow(["เธเธเธฑเธเธเธฒเธ", `${context.selectedEmployee.emp_code} - ${context.selectedEmployee.fullname}`]),
    csvRow(["เธเนเธงเธเธงเธฑเธเธ—เธตเน", `${context.range.startDate} เธ–เธถเธ ${context.range.endDate}`]),
    csvRow([]),
    csvRow(["เธ เธฒเธเธฃเธงเธก"]),
    csvRow(["เธซเธฑเธงเธเนเธญ", "เธเนเธฒ"]),
    csvRow(["เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ", summary.totalRecords]),
    csvRow(["เธเธณเธเธงเธเธงเธฑเธ", summary.workDays.size]),
    csvRow(["เน€เธงเธฅเธฒเธชเธธเธ—เธเธด", formatMinutesToHourText(summary.totalNetMinutes)]),
    csvRow(["เธเธฑเนเธงเนเธกเธเธชเธธเธ—เธเธด", formatDecimalHours(summary.totalNetMinutes)]),
    csvRow(["เธกเธฒเธชเธฒเธข", summary.lateCount]),
    csvRow(["เธญเธญเธเธเนเธญเธเน€เธงเธฅเธฒ", summary.earlyOutCount]),
    csvRow([]),
    csvRow(["เธชเธฃเธธเธเธฃเธฒเธขเธงเธฑเธ"]),
    csvRow(["เธงเธฑเธเธ—เธตเน", "เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ", "เน€เธงเธฅเธฒเธชเธธเธ—เธเธด", "เธเธฑเนเธงเนเธกเธเธชเธธเธ—เธเธด", "เธกเธฒเธชเธฒเธข", "เธญเธญเธเธเนเธญเธเน€เธงเธฅเธฒ"])
  ];

  dailySummaries.forEach((item) => {
    lines.push(
      csvRow([
        item.date,
        item.records,
        formatMinutesToHourText(item.netMinutes),
        formatDecimalHours(item.netMinutes),
        item.lateCount,
        item.earlyOutCount
      ])
    );
  });

  lines.push(csvRow([]));
  lines.push(csvRow(["เธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”"]));
  lines.push(csvRow(["เธงเธฑเธเธ—เธตเน", "เน€เธงเธฅเธฒเน€เธเนเธฒ", "เน€เธงเธฅเธฒเธญเธญเธ", "เธเธฑเธ", "เน€เธงเธฅเธฒเธชเธธเธ—เธเธด", "เธเธฑเนเธงเนเธกเธเธชเธธเธ—เธเธด", "เธเธนเนเธเธฑเธเธ—เธถเธ"]));
  records.forEach((record) => {
    lines.push(
      csvRow([
        record.record_date || "",
        record.clock_in || "",
        record.clock_out || "",
        formatMinutesToHourText(record.break_minutes),
        formatMinutesToHourText(record.net_minutes),
        formatDecimalHours(record.net_minutes),
        record.created_by || ""
      ])
    );
  });

  downloadTextFile(
    `personal-time-${context.selectedEmployee.emp_code}-${context.range.startDate}-to-${context.range.endDate}.csv`,
    `\ufeff${lines.join("\r\n")}`
  );
  setPersonalReportMessage("Export เธชเธฃเธธเธเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเธฃเธฒเธขเธเธธเธเธเธฅเน€เธฃเธตเธขเธเธฃเนเธญเธขเนเธฅเนเธง");
  render();
}

function renderPersonalReportTabs() {
  return `
    <div class="module-tabs personal-report-tabs">
      <button class="module-tab ${personalReportActiveTab === "production" ? "active" : ""}" type="button" data-personal-tab="production">
        เธชเธฃเธธเธเธฃเธฒเธขเธเธธเธเธเธฅเธซเธฅเธฑเธ
      </button>
      <button class="module-tab ${personalReportActiveTab === "time" ? "active" : ""}" type="button" data-personal-tab="time">
        เธชเธฃเธธเธเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธ
      </button>
    </div>
  `;
}

function renderPersonalReportFilter(context) {
  return `
    <section class="panel">
      <form class="personal-report-form" id="personalReportForm">
        <label class="field compact-field">
          <span>เธเธเธฑเธเธเธฒเธ</span>
          <select id="personalReportEmployee" name="employee_id" required>
            ${context.employees
              .map(
                (employee) => `
                  <option value="${employee.id}" ${
                  Number(context.selectedEmployeeId) === employee.id ? "selected" : ""
                }>
                    ${escapeHtml(employee.emp_code)} - ${escapeHtml(employee.fullname)}
                  </option>`
              )
              .join("")}
          </select>
        </label>

        <label class="field compact-field">
          <span>เธงเธฑเธเธ—เธตเนเน€เธฃเธดเนเธก</span>
          <input id="personalReportStartDate" name="start_date" type="date" value="${escapeHtml(context.range.startDate)}" />
        </label>

        <label class="field compact-field">
          <span>เธงเธฑเธเธ—เธตเนเธชเธดเนเธเธชเธธเธ”</span>
          <input id="personalReportEndDate" name="end_date" type="date" value="${escapeHtml(context.range.endDate)}" />
        </label>

        ${
          personalReportActiveTab === "production"
            ? `
              <button class="btn btn-outline" id="exportPersonalExcel" type="button" ${context.selectedEmployee ? "" : "disabled"}>
                Export Excel
              </button>
              <button class="btn btn-primary report-primary-button" id="exportPersonalPdf" type="button" ${context.selectedEmployee ? "" : "disabled"}>
                Export PDF
              </button>
            `
            : `
              <button class="btn btn-primary report-primary-button" id="exportPersonalTime" type="button" ${context.selectedEmployee ? "" : "disabled"}>
                Export
              </button>
            `
        }
      </form>
    </section>
  `;
}

function renderPersonalProductionSummaryTab(context) {
  const records = context.selectedEmployee
    ? recordsForPersonalReport(context.selectedEmployee.id, context.range.startDate, context.range.endDate)
    : [];
  const totals = summarizePersonalRecords(records);
  const dailySummaries = getDailyPersonalSummaries(records);
  const pileSummaries = getPilePersonalSummaries(records);

  return `
    ${
      context.selectedEmployee && !records.length
        ? `<div class="alert alert-success">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเธเธฅเธเธฒเธเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธเธตเน เนเธ•เนเธชเธฒเธกเธฒเธฃเธ– Export เธฃเธฒเธขเธเธฒเธเน€เธเธฅเนเธฒเธเธญเธเธเธเธฑเธเธเธฒเธเธ—เธตเนเน€เธฅเธทเธญเธเนเธ”เน</div>`
        : ""
    }

    <div class="summary-metrics">
      <div class="metric-card metric-green">
        <span>เธเนเธณเธซเธเธฑเธเธฃเธงเธก</span>
        <strong>${numberText(totals.water + totals.flower)} เธเธ.</strong>
        <small>เธเนเธณ ${numberText(totals.water)} | เธ”เธญเธ ${numberText(totals.flower)}</small>
      </div>
      <div class="metric-card metric-blue">
        <span>เธขเธญเธ”เน€เธเธดเธเธฃเธงเธก</span>
        <strong>${money(totals.amount)}</strong>
        <small>เธเธฒเธเธฃเธฒเธขเธเธฒเธฃเธเธญเธเธเธเธฑเธเธเธฒเธเธ—เธตเนเน€เธฅเธทเธญเธ</small>
      </div>
      <div class="metric-card metric-purple">
        <span>เธงเธฑเธเธ—เธตเนเธกเธตเธเธฅเธเธฒเธ</span>
        <strong>${totals.days.size.toLocaleString("th-TH")} เธงเธฑเธ</strong>
        <small>${escapeHtml(context.range.startDate)} เธ–เธถเธ ${escapeHtml(context.range.endDate)}</small>
      </div>
      <div class="metric-card metric-orange">
        <span>เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ</span>
        <strong>${totals.records.toLocaleString("th-TH")}</strong>
        <small>${context.selectedEmployee ? escapeHtml(context.selectedEmployee.emp_code) : "เธขเธฑเธเนเธกเนเธกเธตเธเธเธฑเธเธเธฒเธ"}</small>
      </div>
    </div>

    <section class="personal-report-grid">
      <section class="table-card">
        <div class="table-heading">เธชเธฃเธธเธเธฃเธฒเธขเธงเธฑเธ</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>เธงเธฑเธเธ—เธตเน</th>
                <th>เธเนเธณเธซเธเธฑเธเธ”เธญเธ</th>
                <th>เธเนเธณเธซเธเธฑเธเธเนเธณ</th>
                <th>เธฃเธงเธกเน€เธเนเธเน€เธเธดเธ</th>
              </tr>
            </thead>
            <tbody>
              ${
                dailySummaries.length
                  ? dailySummaries.map(renderPersonalDailyRow).join("")
                  : `<tr><td colspan="4" class="empty-cell">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธเธตเน</td></tr>`
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="table-card">
        <div class="table-heading">เธชเธฃเธธเธเธ•เธฒเธกเธเธญเธ</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>เธเธญเธ</th>
                <th>เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ</th>
                <th>เธเนเธณเธซเธเธฑเธเธ”เธญเธ</th>
                <th>เธเนเธณเธซเธเธฑเธเธเนเธณ</th>
                <th>เธฃเธงเธกเน€เธเนเธเน€เธเธดเธ</th>
              </tr>
            </thead>
            <tbody>
              ${
                pileSummaries.length
                  ? pileSummaries.map(renderPersonalPileRow).join("")
                  : `<tr><td colspan="5" class="empty-cell">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเธ•เธฒเธกเธเธญเธเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธเธตเน</td></tr>`
              }
            </tbody>
          </table>
        </div>
      </section>
    </section>
  `;
}

function renderPersonalTimeSummaryTab(context) {
  const records = context.selectedEmployee
    ? recordsForPersonalTimeReport(context.selectedEmployee.id, context.range.startDate, context.range.endDate)
    : [];
  const summary = summarizeTimeRecords(records);
  const dailySummaries = getPersonalTimeDailySummaries(records);

  if (!records.length) {
    return `
      <section class="panel">
        <div class="empty-state">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเธเธญเธเธเธเธฑเธเธเธฒเธเธเธเธเธตเนเนเธเธเนเธงเธเธงเธฑเธเธ—เธตเนเธ—เธตเนเน€เธฅเธทเธญเธ</div>
      </section>
    `;
  }

  return `
    <div class="summary-metrics">
      ${renderTimeSummaryMetricCard("เธเธณเธเธงเธเธฃเธฒเธขเธเธฒเธฃ", `${summary.totalRecords.toLocaleString("th-TH")} เธฃเธฒเธขเธเธฒเธฃ`, `${summary.workDays.size.toLocaleString("th-TH")} เธงเธฑเธเธ—เธณเธเธฒเธ`, "metric-green")}
      ${renderTimeSummaryMetricCard("เน€เธงเธฅเธฒเธชเธธเธ—เธเธดเธฃเธงเธก", `${formatMinutesToHourText(summary.totalNetMinutes)} เธเธก.`, `${formatDecimalHours(summary.totalNetMinutes)} เธเธฑเนเธงเนเธกเธ`, "metric-blue")}
      ${renderTimeSummaryMetricCard("เน€เธงเธฅเธฒเธเธฑเธเธฃเธงเธก", `${formatMinutesToHourText(summary.totalBreakMinutes)} เธเธก.`, "เธซเธฑเธเธเธฒเธเน€เธงเธฅเธฒเธ—เธณเธเธฒเธเธ•เธฒเธกเธเธ•เธดเธเธฒ", "metric-purple")}
      ${renderTimeSummaryMetricCard("เธชเธ–เธฒเธเธฐเน€เธงเธฅเธฒ", `เธชเธฒเธข ${summary.lateCount.toLocaleString("th-TH")} / เธญเธญเธเธเนเธญเธ ${summary.earlyOutCount.toLocaleString("th-TH")}`, "เน€เธ—เธตเธขเธเน€เธงเธฅเธฒ 08:00 - 17:00", "metric-orange")}
    </div>

    <section class="time-summary-grid">
      <section class="table-card">
        <div class="table-heading">เธชเธฃเธธเธเน€เธงเธฅเธฒเธฃเธฒเธขเธงเธฑเธ</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>เธงเธฑเธเธ—เธตเน</th>
                <th>เธฃเธฒเธขเธเธฒเธฃ</th>
                <th>เน€เธงเธฅเธฒเธชเธธเธ—เธเธด</th>
                <th>เธเธฑเนเธงเนเธกเธ</th>
                <th>เธกเธฒเธชเธฒเธข</th>
                <th>เธญเธญเธเธเนเธญเธ</th>
              </tr>
            </thead>
            <tbody>
              ${dailySummaries
                .map(
                  (item) => `
                    <tr>
                      <td>${escapeHtml(item.date)}</td>
                      <td>${item.records.toLocaleString("th-TH")}</td>
                      <td>${escapeHtml(formatMinutesToHourText(item.netMinutes))}</td>
                      <td>${escapeHtml(formatDecimalHours(item.netMinutes))}</td>
                      <td>${item.lateCount.toLocaleString("th-TH")}</td>
                      <td>${item.earlyOutCount.toLocaleString("th-TH")}</td>
                    </tr>`
                )
                .join("")}
            </tbody>
          </table>
        </div>
      </section>

      <section class="table-card">
        <div class="table-heading">เธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”เน€เธงเธฅเธฒเน€เธเนเธฒเธญเธญเธ</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>เธงเธฑเธเธ—เธตเน</th>
                <th>เน€เธเนเธฒ</th>
                <th>เธญเธญเธ</th>
                <th>เธเธฑเธ</th>
                <th>เธชเธธเธ—เธเธด</th>
                <th>เธเธฑเนเธงเนเธกเธ</th>
                <th>เธเธนเนเธเธฑเธเธ—เธถเธ</th>
              </tr>
            </thead>
            <tbody>
              ${records
                .map(
                  (record) => `
                    <tr>
                      <td>${escapeHtml(record.record_date || "-")}</td>
                      <td>${escapeHtml(record.clock_in || "-")}</td>
                      <td>${escapeHtml(record.clock_out || "-")}</td>
                      <td>${escapeHtml(formatMinutesToHourText(record.break_minutes))}</td>
                      <td>${escapeHtml(formatMinutesToHourText(record.net_minutes))}</td>
                      <td>${escapeHtml(formatDecimalHours(record.net_minutes))}</td>
                      <td>${escapeHtml(record.created_by || "-")}</td>
                    </tr>`
                )
                .join("")}
            </tbody>
          </table>
        </div>
      </section>
    </section>
  `;
}

function renderPersonalReport(moduleItem) {
  const context = getPersonalReportContext();

  return `
    <section class="summary-page">
      <div class="summary-header">
        <div>
          <h2>${escapeHtml(moduleItem.label)}</h2>
          <p>เน€เธฅเธทเธญเธเธเธเธฑเธเธเธฒเธเนเธฅเธฐเธเนเธงเธเธงเธฑเธเธ—เธตเนเน€เธเธทเนเธญเธ”เธนเธชเธฃเธธเธเธเธฅเธเธฒเธเธซเธฃเธทเธญเธชเธฃเธธเธเน€เธงเธฅเธฒเน€เธเนเธฒเธเธฒเธเนเธเธเธฃเธฒเธขเธเธธเธเธเธฅ</p>
        </div>
        <div class="summary-filters">
          <button class="btn btn-outline" data-route="reports" type="button">Export เธซเธฅเธฒเธขเธเธ</button>
        </div>
      </div>

      ${renderPersonalReportTabs()}

      ${
        personalReportMessage
          ? `<div class="alert ${
              personalReportMessageType === "error" ? "alert-error" : "alert-success"
            }">${escapeHtml(personalReportMessage)}</div>`
          : ""
      }

      ${renderPersonalReportFilter(context)}

      ${
        personalReportActiveTab === "time"
          ? renderPersonalTimeSummaryTab(context)
          : renderPersonalProductionSummaryTab(context)
      }
    </section>
  `;
}

function bindPersonalReportEvents() {
  document.querySelectorAll("[data-personal-tab]").forEach((button) => {
    button.addEventListener("click", () => {
      personalReportActiveTab = button.dataset.personalTab || "production";
      personalReportMessage = "";
      render();
    });
  });

  document.querySelector("#personalReportForm")?.addEventListener("change", (event) => {
    const target = event.target;
    if (target.id === "personalReportEmployee") {
      personalReportEmployeeId = target.value;
    }
    if (target.id === "personalReportStartDate") {
      personalReportStartDate = target.value || new Date().toISOString().slice(0, 10);
    }
    if (target.id === "personalReportEndDate") {
      personalReportEndDate = target.value || personalReportStartDate;
    }
    personalReportMessage = "";
    render();
  });

  document.querySelector("#exportPersonalTime")?.addEventListener("click", exportPersonalTimeSummary);

  document.querySelector("#exportPersonalPdf")?.addEventListener("click", async () => {
    try {
      await syncReportData();
      await downloadReport(`${REPORT_API_BASE}/reports/employee-range-pdf`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildPersonalReportPayload())
      });
      setPersonalReportMessage("เธ”เธฒเธงเธเนเนเธซเธฅเธ” PDF เธฃเธฒเธขเธเธธเธเธเธฅเนเธฅเนเธง");
      render();
    } catch (error) {
      personalReportExportError(error);
    }
  });

  document.querySelector("#exportPersonalExcel")?.addEventListener("click", async () => {
    try {
      await syncReportData();
      await downloadReport(`${REPORT_API_BASE}/reports/employee-range-excel`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildPersonalReportPayload())
      });
      setPersonalReportMessage("เธ”เธฒเธงเธเนเนเธซเธฅเธ” Excel เธฃเธฒเธขเธเธธเธเธเธฅเนเธฅเนเธง");
      render();
    } catch (error) {
      personalReportExportError(error);
    }
  });
}

window.addEventListener("hashchange", render);
startLiveClock();
render();
