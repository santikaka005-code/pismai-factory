function renderSummaryExport(moduleItem) {
  const productOptions = [
    { id: "all", label: "เธ—เธฑเนเธเธซเธกเธ”" },
    ...productionFruitOptions.map((item) => ({ id: item.id, label: item.label }))
  ];
  const selectedProductLabel =
    productOptions.find((item) => item.id === summaryReportExportProduct)?.label || "เธ—เธฑเนเธเธซเธกเธ”";

  return `
    <section class="summary-page">
      <div class="summary-header">
        <div>
          <h2>${escapeHtml(moduleItem.label)}</h2>
          <p>${escapeHtml(moduleItem.description)}</p>
        </div>
        <button class="btn btn-outline" type="button" data-route="summary-main">เธเธฅเธฑเธเนเธเธชเธฃเธธเธเธเนเธญเธกเธนเธฅเธซเธฅเธฑเธ</button>
      </div>

      ${
        summaryReportExportMessage
          ? `<div class="alert ${summaryReportExportMessageType === "error" ? "alert-error" : "alert-success"}">${escapeHtml(summaryReportExportMessage)}</div>`
          : ""
      }

      <section class="panel summary-export-workspace">
        <div class="panel-head">
          <div>
            <h2>เธฃเธฒเธขเธเธฒเธเธชเธฃเธธเธเธเนเธณเธซเธเธฑเธเธ•เธฒเธกเธเธญเธ</h2>
            <p>เธชเธฃเนเธฒเธเธฃเธฒเธขเธเธฒเธ Summary Report เธชเธณเธซเธฃเธฑเธ PDF เนเธฅเธฐ Excel เนเธ”เธขเนเธชเธ”เธเน€เธเธเธฒเธฐเธชเธฃเธธเธเธ•เธฒเธกเธเธญเธ</p>
          </div>
          <span class="badge badge-success">A4 Portrait</span>
        </div>

        <form class="summary-export-form" id="summaryExportForm">
          <label class="field">
            <span>เธเธฒเธเธงเธฑเธเธ—เธตเน</span>
            <input name="start_date" type="date" value="${escapeHtml(summaryReportExportStartDate)}" required />
          </label>
          <label class="field">
            <span>เธ–เธถเธเธงเธฑเธเธ—เธตเน</span>
            <input name="end_date" type="date" value="${escapeHtml(summaryReportExportEndDate)}" required />
          </label>
          <label class="field">
            <span>เธชเธดเธเธเนเธฒ</span>
            <select name="product">
              ${productOptions
                .map(
                  (item) => `
                    <option value="${escapeHtml(item.id)}" ${item.id === summaryReportExportProduct ? "selected" : ""}>
                      ${escapeHtml(item.label)}
                    </option>`
                )
                .join("")}
            </select>
          </label>
          <label class="field">
            <span>เธเธฃเธฐเน€เธ เธ—เธชเธดเธเธเนเธฒ</span>
            <input name="product_type" value="${escapeHtml(summaryReportExportProductType)}" placeholder="เธ—เธฑเนเธเธซเธกเธ”" />
          </label>
        </form>

        <div class="summary-export-preview">
          <div>
            <span>เธเธทเนเธญเธฃเธฒเธขเธเธฒเธ</span>
            <strong>เธฃเธฒเธขเธเธฒเธเธชเธฃเธธเธเธเนเธณเธซเธเธฑเธเธ•เธฒเธกเธเธญเธ</strong>
          </div>
          <div>
            <span>เธเนเธงเธเธงเธฑเธเธ—เธตเน</span>
            <strong>${escapeHtml(summaryReportExportStartDate)} เธ–เธถเธ ${escapeHtml(summaryReportExportEndDate)}</strong>
          </div>
          <div>
            <span>เธชเธดเธเธเนเธฒ</span>
            <strong>${escapeHtml(selectedProductLabel)}</strong>
          </div>
          <div>
            <span>เธฃเธฐเธเธ</span>
            <strong>SystemPro</strong>
          </div>
        </div>

        <div class="summary-export-actions">
          <button class="btn btn-outline" id="exportSummaryExcel" type="button">Export Excel</button>
          <button class="btn btn-primary" id="exportSummaryPdf" type="button">Export PDF</button>
        </div>
      </section>
    </section>
  `;
}

function renderSummaryAll(moduleItem) {
  const selectedDate = getSelectedSummaryDate();
  summaryDate = selectedDate;
  const records = getDashboardRecordsForDate(selectedDate);
  const totals = getProductionTotals(records);
  const pileSummaries = getPileSummaries(records);

  return `
    <section class="summary-page">
      <div class="summary-header">
        <div>
          <h2>${escapeHtml(moduleItem.label)}</h2>
          <p>${escapeHtml(moduleItem.description)}</p>
        </div>
        <div class="summary-filters">
          <label class="summary-date-field">
            <span>เธงเธฑเธเธ—เธตเน</span>
            <input id="summaryDate" type="date" value="${escapeHtml(selectedDate)}" />
          </label>
          <span class="summary-mode-pill">${records.length.toLocaleString("th-TH")} เธฃเธฒเธขเธเธฒเธฃ</span>
          <button class="btn btn-outline" type="button" data-route="summary-export">Export</button>
        </div>
      </div>

      <div class="summary-metrics">
        <div class="metric-card metric-green">
          <span>เธเนเธณเธซเธเธฑเธเธฃเธงเธกเธ—เธฑเนเธเธซเธกเธ”</span>
          <strong>${numberText(totals.water + totals.flower)} เธเธ.</strong>
          <small>เธเนเธณ ${numberText(totals.water)} เธเธ. | เธ”เธญเธ ${numberText(totals.flower)} เธเธ.</small>
        </div>
        <div class="metric-card metric-blue">
          <span>เธขเธญเธ”เน€เธเธดเธเธฃเธงเธก</span>
          <strong>${money(totals.amount)}</strong>
          <small>เธเธฒเธเธฃเธฒเธขเธเธฒเธฃเธงเธฑเธเธ—เธตเนเน€เธฅเธทเธญเธ</small>
        </div>
        <div class="metric-card metric-purple">
          <span>เธเธเธฑเธเธเธฒเธเธ—เธฑเนเธเธซเธกเธ”</span>
          <strong>${totals.people.size.toLocaleString("th-TH")} เธเธ</strong>
          <small>เธเธเธฑเธเธเธฒเธเธ—เธตเนเธกเธตเธฃเธฒเธขเธเธฒเธฃ</small>
        </div>
        <div class="metric-card metric-orange">
          <span>เธเธณเธเธงเธเธเธญเธ</span>
          <strong>${pileSummaries.length.toLocaleString("th-TH")}</strong>
          <small>${escapeHtml(selectedDate)}</small>
        </div>
      </div>

      <section class="summary-grid">
        <section class="panel chart-panel">
          <div class="panel-head">
            <div>
              <h2>เธเธฃเธฒเธเน€เธเธฃเธตเธขเธเน€เธ—เธตเธขเธเธเนเธณเธซเธเธฑเธ</h2>
              <p>เน€เธเธฃเธตเธขเธเน€เธ—เธตเธขเธเธเนเธณเธซเธเธฑเธเธเนเธณเนเธฅเธฐเธ”เธญเธเนเธขเธเธ•เธฒเธกเธเธญเธ</p>
            </div>
            <div class="chart-legend">
              <span><i class="legend-water"></i>เธเนเธณ</span>
              <span><i class="legend-flower"></i>เธ”เธญเธ</span>
            </div>
          </div>
          <div class="summary-chart">
            ${pileSummaries.length ? renderDashboardBars(pileSummaries) : `<div class="empty-state">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเธชเธณเธซเธฃเธฑเธเธงเธฑเธเธ—เธตเนเน€เธฅเธทเธญเธ</div>`}
          </div>
        </section>

        <section class="table-card">
          <div class="table-heading">เธชเธฃเธธเธเธ•เธฒเธกเธเธญเธ</div>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>เธเธญเธ</th>
                  <th>เธเนเธณเธซเธเธฑเธเธเนเธณ</th>
                  <th>เธเนเธณเธซเธเธฑเธเธ”เธญเธ</th>
                  <th>เธฃเธงเธก</th>
                  <th>เธฃเธงเธกเน€เธเธดเธ</th>
                </tr>
              </thead>
              <tbody>
                ${
                  pileSummaries.length
                    ? pileSummaries.map(renderPileSummaryRow).join("")
                    : `<tr><td colspan="5" class="empty-cell">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเธชเธณเธซเธฃเธฑเธเธงเธฑเธเธ—เธตเนเน€เธฅเธทเธญเธ</td></tr>`
                }
              </tbody>
            </table>
          </div>
        </section>
      </section>

      <section class="table-card">
        <div class="table-heading">เธฃเธฒเธขเธฅเธฐเน€เธญเธตเธขเธ”เธฃเธฒเธขเธเธฒเธฃ</div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>เน€เธงเธฅเธฒ</th>
                <th>เธฃเธซเธฑเธชเธเธเธฑเธเธเธฒเธ</th>
                <th>เธเธทเนเธญเธเธเธฑเธเธเธฒเธ</th>
                <th>เธเธญเธ</th>
                <th>เธเนเธณเธซเธเธฑเธเธเนเธณ</th>
                <th>เธเนเธณเธซเธเธฑเธเธ”เธญเธ</th>
                <th>เธฃเธงเธกเน€เธเธดเธ</th>
                <th>เธเธนเนเธเธฑเธเธ—เธถเธ</th>
              </tr>
            </thead>
            <tbody>
              ${
                records.length
                  ? records.map(renderDashboardDetailRow).join("")
                  : `<tr><td colspan="8" class="empty-cell">เธขเธฑเธเนเธกเนเธกเธตเธเนเธญเธกเธนเธฅเธชเธณเธซเธฃเธฑเธเธงเธฑเธเธ—เธตเนเน€เธฅเธทเธญเธ</td></tr>`
              }
            </tbody>
          </table>
