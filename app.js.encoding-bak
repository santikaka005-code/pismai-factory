            <span>Pitsamai</span>
            <strong>Factory Wage</strong>
          </div>
          <nav class="nav-stack">
            ${visibleModules
              .map(
                (item) => `
                  <button class="nav-button ${item.id === route ? "active" : ""}" data-route="${item.id}" type="button">
                    <span class="nav-label">
                      <span class="nav-icon">${escapeHtml(item.icon || "โ€ข")}</span>
                      ${escapeHtml(item.label)}
                    </span>
